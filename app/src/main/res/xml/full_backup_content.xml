<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android 11 and older counterpart of data_extraction_rules.xml. Keep the two in step.
    Here one list serves both cloud backup and device-to-device transfer, so each entry says
    under which condition it applies.
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="datastore/" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
