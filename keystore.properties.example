# Template for release signing. Copy to keystore.properties (which is git-ignored) and fill in.
# Never commit the real file or the keystore itself. See docs/RELEASE.md.
#
# storeFile is resolved relative to the repository root. Keep the keystore outside the repo
# if you can and use an absolute path with forward slashes, e.g. C:/Users/you/keys/trosko-upload.jks
storeFile=
storePassword=
keyAlias=
keyPassword=
